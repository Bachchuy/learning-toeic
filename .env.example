# ==========================================
# TOEIC AI Platform - Environment Variables Template
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to Git!
# ==========================================

# Supabase Public API (Accessible from browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Supabase Service Role Key (SERVER-ONLY - NEVER EXPOSE TO CLIENT)
# Bất biến §6.1 & §6.7: Service role chỉ dùng ở server cho admin script và xóa tài khoản.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
